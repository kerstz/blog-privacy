# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required (the app refuses to start without these) ---
SECRET_KEY=change_me
ENCRYPTION_KEY=change_me
ENCRYPTION_SALT=change_me

# Iterations PBKDF2 pour la derivation de la cle de chiffrement.
# 100000 par defaut, pour rester compatible avec les messages deja en base.
# NOUVELLE INSTALLATION (base vide) : mettre 600000, recommandation OWASP.
# Changer cette valeur sur une base existante rend les anciens messages illisibles.
# ENCRYPTION_ITERATIONS=600000

# --- Optional ---
# DATABASE_URL=sqlite:///blog.db
# SESSION_COOKIE_SECURE=true          # defaut: true. Passer a false uniquement en dev HTTP
# SESSION_COOKIE_NAME=                # defaut: __Host-sid en HTTPS, sid sinon
# MAX_CONTENT_LENGTH=12582912
# MAX_UPLOAD_BYTES=10485760           # per uploaded file
# SECURITY_STATE_DB=instance/security_state.db   # persistent rate limiter (keys are hashed)
# ONION_ADDRESS=                      # v3 onion address: adds the Onion-Location header

# --- Vie privee / reseau ---
# TRUSTED_PROXY_COUNT=1               # nombre de reverse proxys de confiance devant
#                                     # l'application (nginx, Caddy, service onion).
#                                     # TRUST_PROXY=true (ancienne syntaxe) vaut 1.
#                                     # Sans proxy, laisser a 0 : un client pourrait
#                                     # forger X-Forwarded-For et contourner le
#                                     # rate limiting.
# FORCE_HSTS=true                     # envoyer HSTS meme si Flask ne voit pas HTTPS
#                                     # (cas d'une terminaison TLS en amont).
#                                     # A NE PAS activer pour un service .onion.
# TEMPLATE_AUTO_RELOAD=true          # dev : recharge les gabarits sans redemarrer
# LOG_CLIENT_IP=true                  # defaut: false. Les adresses IP sont retirees
#                                     # des journaux ; ne reactiver qu'en cas de besoin
#                                     # de debogage explicite.

# --- API mobile d'administration (/api/admin/mobile/*) ---
# DESACTIVEE par defaut (les routes repondent 404). Mettre true pour l'activer.
# Elle utilise Basic Auth ; un compte administrateur DOIT avoir la 2FA TOTP et
# envoyer le code courant dans l'en-tete X-TOTP-Code (sans code valide : 401).
# Les echecs repetes verrouillent le pseudo 15 minutes (429).
# MOBILE_API_ENABLED=false

# --- Serveur de developpement (python wsgi.py) ---
# En production, gunicorn est lance par systemd : ces variables n'y servent pas.
# HOST=127.0.0.1                      # defaut 127.0.0.1 ; ne pas mettre 0.0.0.0
# PORT=5000                           # defaut 5000
# FLASK_DEBUG=false                   # JAMAIS true en production (console Werkzeug)

# --- Sauvegardes chiffrees (backup.sh) ---
# Passphrase OBLIGATOIRE pour backup.sh : 16 caracteres minimum. Generer avec
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# et en garder une copie HORS du serveur (sans elle, aucune restauration).
# BACKUP_PASSPHRASE=change_me
# BACKUP_KEEP=14                      # nombre de sauvegardes conservees (defaut 14)
# BACKUP_REMOTE=                      # cible rsync facultative (user@hote:/chemin/)
#                                     # recevant la copie chiffree hors site

# --- Mises a jour (update.sh / auto-update.sh) ---
# UPDATE_RESTART_CMD=sudo systemctl restart blog   # commande de redemarrage apres mise a jour
# Verification de signature (fail closed) : update.sh refuse toute mise a jour
# dont le commit cible n'est pas signe par une cle du trousseau dedie.
# UPDATE_GPG_HOME=/srv/blog-update-gnupg      # GNUPGHOME dedie (chmod 700), cles publiques autorisees uniquement
# UPDATE_TRUSTED_FINGERPRINTS=                # facultatif : empreintes completes autorisees (espaces ou virgules)
# UPDATE_ALLOW_UNSIGNED=0                     # 1 = mise a jour SANS verification (deconseille)
# UPDATE_PIP_AUDIT_SPEC=pip-audit==2.9.0      # pip-audit lance via uvx/pipx, jamais dans le venv de prod
# KEEP_UPDATE_BACKUPS=10                      # nombre de sauvegardes pre-mise-a-jour conservees
# Les sauvegardes pre-mise-a-jour sont chiffrees avec BACKUP_PASSPHRASE.

# --- Pont Telegram : RETIRE ---
# Le pont d'administration Telegram a ete archive dans archive/telegram/.
# Il transmettait aux serveurs de Telegram le contenu DECHIFFRE des messages
# des utilisateurs, avec leur pseudo et leurs pieces jointes. Les variables
# TELEGRAM_* ne sont plus lues par l'application ; les laisser dans un .env
# n'a aucun effet.
