# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required (the app refuses to start without these) ---
SECRET_KEY=change_me
ENCRYPTION_KEY=change_me
ENCRYPTION_SALT=change_me

# --- Optional ---
# DATABASE_URL=sqlite:///blog.db
# SESSION_COOKIE_SECURE=true          # MUST be true in production (HTTPS): secure cookies + HSTS
# MAX_CONTENT_LENGTH=12582912
# MAX_UPLOAD_BYTES=10485760
# TRUSTED_PROXY_COUNT=1               # only if behind nginx/Caddy (real client IP for rate limiting)

# --- Telegram admin bot (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_ADMIN_USER_ID=
# TELEGRAM_ADMIN_PIN=
# TELEGRAM_ADMIN_SESSION_TTL=
# TELEGRAM_AUDIT_CHAT_ID=
