# systemd unit: /etc/systemd/system/blog.service
# Runs the blog as an unprivileged dedicated user, bound to localhost only.
#   sudo useradd --system --home /srv/blog --shell /usr/sbin/nologin blog
#   sudo systemctl daemon-reload && sudo systemctl enable --now blog
[Unit]
Description=blog-privacy (Flask + SocketIO)
After=network.target

[Service]
User=blog
Group=blog
WorkingDirectory=/srv/blog
EnvironmentFile=/srv/blog/.env
# One worker (Telegram poller + SSE live in the process), many threads.
ExecStart=/srv/blog/venv/bin/gunicorn --workers 1 --threads 32 --bind 127.0.0.1:8000 wsgi:application
Restart=on-failure

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/blog/instance /srv/blog/uploads /srv/blog/backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
